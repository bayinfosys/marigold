Comment: "Instruct(chat) Pipeline"
StartAt: CheckIfExists
States:
  CheckIfExists:
    Type: Task
    Resource: "arn:aws:states:::dynamodb:getItem"
    Parameters:
      TableName: "${results_cache_table}"
      Key:
        PK:
          S.$: "$.destination.userid"
        SK:
          S.$: "$.destination.message_id"
    ResultPath: "$.dynamoResult"
    Next: DecideNextStep

  DecideNextStep:
    Type: Choice
    Choices:
      - Variable: "$.dynamoResult.Item"
        IsPresent: true
        Next: CheckStatus
    Default: SelectModel

  CheckStatus:
    Type: Choice
    Choices:
      - Variable: "$.dynamoResult.Item.Status.S"
        StringEquals: "complete"
        Next: ReturnExistingItem
      - Variable: "$.dynamoResult.Item.Status.S"
        StringEquals: "pending"
        Next: ReturnPendingStatus
      - Variable: "$.dynamoResult.Item.Status.S"
        StringEquals: "started"
        Next: UpdateToPending

  UpdateToPending:
    Type: Task
    Resource: "arn:aws:states:::dynamodb:updateItem"
    Parameters:
      TableName: "${results_cache_table}"
      Key:
        PK:
          S.$: "$.destination.userid"
        SK:
          S.$: "$.destination.message_id"
      UpdateExpression: "SET #status = :status"
      ExpressionAttributeNames:
        "#status": "Status"
      ExpressionAttributeValues:
        ":status":
          S: "pending"
    ResultPath: "$.updateToPendingResult"
    Next: SelectModel

  UpdateToError:
    Type: Task
    Resource: "arn:aws:states:::dynamodb:updateItem"
    Parameters:
      TableName: "${results_cache_table}"
      Key:
        PK:
          S.$: "$.destination.userid"
        SK:
          S.$: "$.destination.message_id"
      UpdateExpression: "SET #status = :status"
      ExpressionAttributeNames:
        "#status": "Status"
      ExpressionAttributeValues:
        ":status":
          S: "error"
    ResultPath: "$.updateToErrorResult"
    Next: GeneralErrorState

  ReturnExistingItem:
    Type: Pass
    Parameters:
      "message_id.$": "$.destination.message_id"
      "response.$": "States.StringToJson($.dynamoResult.Item.Response.S)"
    Next: SuccessState

  ReturnPendingStatus:
    Type: Pass
    Parameters:
      "status": "pending"
    Next: SuccessState

  SelectModel:
    Type: Choice
    Choices:
      - Variable: "$.input.model"
        StringEquals: "qwen/qwen2-05b-instruct"
        Next: ModelQwen205bInstruct
      - Variable: "$.input.model"
        StringEquals: "qwen/qwen2-15b-instruct"
        Next: ModelQwen215bInstruct
      - Variable: "$.input.model"
        StringEquals: "microsoft/phi-3-mini-128k-instruct"
        Next: ModelPhi3Mini128kInstruct
    Default: InvalidModelState

  ModelQwen205bInstruct:
    Type: Task
    Resource: "${qwen2-05b-instruct}"
    ResultPath: "$.modelResult"
    Next: WriteToDynamoDB
    Catch:
      - ErrorEquals:
          - States.ALL
        ResultPath: "$.errorInfo"
        Next: ModelErrorState

  ModelQwen215bInstruct:
    Type: Task
    Resource: "${qwen2-15b-instruct}"
    ResultPath: "$.modelResult"
    Next: WriteToDynamoDB
    Catch:
      - ErrorEquals:
          - States.ALL
        ResultPath: "$.errorInfo"
        Next: ModelErrorState

  ModelPhi3Mini128kInstruct:
    Type: Task
    Resource: "${microsoft-phi-3-mini-128k-instruct}"
    ResultPath: "$.modelResult"
    Next: WriteToDynamoDB
    Catch:
      - ErrorEquals:
          - States.ALL
        ResultPath: "$.errorInfo"
        Next: ModelErrorState

  WriteToDynamoDB:
    Type: Task
    Resource: "arn:aws:states:::dynamodb:updateItem"
    Parameters:
      TableName: "${results_cache_table}"
      Key:
        PK:
          S.$: "$.destination.userid"
        SK:
          S.$: "$.destination.message_id"
      UpdateExpression: "SET #status = :status, #response = :response"
      ExpressionAttributeNames:
        "#status": "Status"
        "#response": "Response"
      ExpressionAttributeValues:
        ":status":
          S: "complete"
        ":response":
          S.$: "$.modelResult.body"
    ResultPath: "$.dynamoResult"
    Next: SuccessState

  SuccessState:
    Type: Succeed

  InvalidModelState:
    Type: Fail
    Error: "Invalid model specified."

  ModelErrorState:
    Type: Pass
    Next: UpdateToError

  GeneralErrorState:
    Type: Fail
    Error: "Internal processing error"
