ARG BASE_IMAGE=python:3.12-slim
FROM $BASE_IMAGE

# install the local requirements
COPY ./package/src/models/environment/local.requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --break-system-packages  -r /tmp/requirements.txt

# Runtime identity -- all must be provided at task launch.
ENV MODEL_TYPE=""
ENV MODEL_HASH=""
ENV MODELNAME=""
ENV AWS_SQS_MODEL_QUEUE=""
ENV SQS_VISIBILITY_TIMEOUT="300"
ENV IDLE_TIMEOUT="180"
ENV LOG_LEVEL="INFO"

WORKDIR /app

CMD ["python3", "-c", "from models.entrypoint_handlers import local_handler; local_handler()"]
